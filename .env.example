# Copy to .env.local and fill in. Never commit real values.
# Bundled into the app (public):
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Sanity project and dataset the app reads (public dataset, read through the API CDN, no token):
EXPO_PUBLIC_SANITY_PROJECT_ID=
EXPO_PUBLIC_SANITY_DATASET=
# Server only (API routes, local scripts). Never prefix with EXPO_PUBLIC_:
CLERK_SECRET_KEY=
# Unsplash "Demo" app Access Key, used only by roam/scripts/fetch-photos.ts:
UNSPLASH_ACCESS_KEY=

# PostHog project key (public by design) and host, embedded into Expo app config at build time:
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://your-posthog-host

SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-11-03/context/organizations/o87rpp0em/mcp/roam-search

